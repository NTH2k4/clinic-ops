{
  "openapi": "3.1.0",
  "info": {
    "title": "CareFlow API",
    "version": "1.0.0",
    "description": "Machine-readable contract for the CareFlow clinic operations API v1. All paths are mounted under /api/v1 and use the shared success, list and error envelopes."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local API server"
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "Catalog" },
    { "name": "Patients" },
    { "name": "Scheduling" },
    { "name": "Appointments" },
    { "name": "Audit" },
    { "name": "Notifications" }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API health",
        "security": [],
        "responses": {
          "200": {
            "description": "API is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "required": ["status", "commit"],
                          "properties": {
                            "status": { "const": "ok" },
                            "commit": { "type": "string" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
